{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "dev:sandbox": "wrangler pages dev dist --d1=kazdoura-production --local --ip 0.0.0.0 --port 3000",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "deploy": "npm run build && wrangler pages deploy dist",
    "db:migrate:local": "wrangler d1 migrations apply kazdoura-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply kazdoura-production --remote",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local",
    "db:console:local": "wrangler d1 execute kazdoura-production --local",
    "test:api": "node tests/api-e2e.mjs",
    "test:ui": "node tests/ui/pos-e2e.mjs && node tests/ui/admin-e2e.mjs",
    "test": "npm run test:api",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.5"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
